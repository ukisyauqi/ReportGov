# Database (SQLite dev / PostgreSQL prod)
DATABASE_URL="file:./dev.db"

# Admin dashboard: proteksi Auth.js (login with Google saja).
# Daftarkan semua email admin yang boleh akses /admin (comma-separated).
# Contoh: ADMIN_ALLOWED_EMAILS="admin1@gmail.com,admin2@go.id"
ADMIN_ALLOWED_EMAILS=""

# Auth.js (next-auth v5)
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth Client (https://console.cloud.google.com/apis/credentials)
# Redirect URI dev: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# URL OpenCode Wrapper (Express + @opencode/client)
WRAPPER_URL="http://localhost:3001"
PORT=3001

# Koneksi OpenCode Server:
# - Kosongkan OPENCODE_URL untuk memakai Mode Default: Service.ensure() (auto-start `opencode serve --service`)
# - Atau isi OPENCODE_URL="http://localhost:4096" jika menjalankan `npm run opencode:serve` manual
OPENCODE_URL=""
OPENCODE_TOKEN=""
OPENCODE_USERNAME=""
OPENCODE_PASSWORD=""

# Model OpenCode (opsional, format JSON {"providerID":"...","id":"..."} atau string "providerID/modelID")
OPENCODE_MODEL=""

# Timeout tunggu balasan /chat dari OpenCode (ms)
OPENCODE_WAIT_TIMEOUT_MS=120000

# Konfigurasi Orchestrator Harness
HARNESS_MAX_ITERS=3
OPENCODE_WORKDIR="/tmp"
GITHUB_TOKEN=""
