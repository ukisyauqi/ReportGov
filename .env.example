# Database (SQLite dev / PostgreSQL prod)
DATABASE_URL="file:./dev.db"

# Admin key untuk proteksi halaman & API /admin (header x-admin-key)
ADMIN_KEY="admin-secret-go-id-2026"

# URL OpenCode Wrapper (Express + @opencode/client)
WRAPPER_URL="http://localhost:3001"
PORT=3001

# Koneksi OpenCode Server:
# - Kosongkan OPENCODE_URL untuk memakai Mode Default: Service.ensure() (auto-start `opencode serve --service`)
# - Atau isi OPENCODE_URL="http://localhost:4096" jika menjalankan `npm run opencode:serve` manual
OPENCODE_URL=""
OPENCODE_TOKEN=""
OPENCODE_USERNAME=""
OPENCODE_PASSWORD=""

# Model OpenCode (opsional, format JSON {"providerID":"...","id":"..."} atau string "providerID/modelID")
OPENCODE_MODEL=""

# Timeout tunggu balasan /chat dari OpenCode (ms)
OPENCODE_WAIT_TIMEOUT_MS=120000

# Konfigurasi Orchestrator Harness
HARNESS_MAX_ITERS=3
OPENCODE_WORKDIR="/tmp"
GITHUB_TOKEN=""
