generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Catatan: SQLite hanya untuk dev lokal (file:./dev.db).
// Production (Cloud Run + Cloud SQL) memakai postgresql.
model RegisteredSite {
  id        String   @id @default(cuid())
  siteUrl   String   @unique
  repoUrl   String
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id          String   @id @default(cuid())
  siteUrl     String
  kategori    String   @default("lainnya")
  judul       String   @default("Laporan Kendala Website")
  deskripsi   String   @db.Text
  screenshot  String?
  namaPelapor String?
  kontak      String?
  status      String   @default("baru") // baru | diproses-ai | pr-dibuat | selesai | ditolak
  prompt      String?  @db.Text
  harnessLog  String?  @db.Text
  prUrl       String?
  repoUrl     String?
  sessionId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
